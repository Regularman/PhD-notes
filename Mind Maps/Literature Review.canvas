		{"id":"326c9db62b1bd97e","type":"file","file":"PhD-notes/Literature Review/2017 - IoT powered servitisation of manufacturing - case study and framework.md","x":-330,"y":-880,"width":400,"height":160,"color":"2"},
		{"id":"23345aa8dc41a8b5","type":"text","text":"# *~={yellow}Economic modelling and feasibility of low carbon heat=~*","x":-1971,"y":-1102,"width":353,"height":109,"color":"3"},
